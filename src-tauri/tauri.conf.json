{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RexPaper",
  "version": "1.0.6",
  "identifier": "com.rexpaper.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    },
    "windows": [
      {
        "title": "RexPaper",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "maximized": false,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "rexxpaper",
    "copyright": "© 2026 rexxpaper",
    "category": "Utility",
    "shortDescription": "A fast, native wallpaper manager for Windows.",
    "longDescription": "RexPaper manages static and mpv-powered live wallpapers on Windows, with a system tray, autostart, and fullscreen auto-pause.",
    "homepage": "https://github.com/rexxpaper/rexpaper",
    "resources": ["mpv/mpv.exe"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "RexPaper",
        "languages": ["English"],
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
